# Vorlage – als „.env“ neben package.json speichern und ausfüllen. Die .env NIE ins Repo (steht in .gitignore).

# Nur lokal lauschen – von außen über den Cloudflare Tunnel
HOST=127.0.0.1
PORT=8787

# Wo liegen die Daten?  datei | sharepoint | sqlserver
#   sharepoint = heute (dieselben Daten wie die Apps)
#   sqlserver  = Ziel, sobald die Apps umgezogen sind
SPEICHER=sharepoint

# --- SharePoint (App-Registrierung mit Sites.Selected, nur Website ElektroIrrgangApps) ---
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE=https://elektroirrgang.sharepoint.com/sites/ElektroIrrgangApps

# --- SQL Server (eigene Datenbank, NICHT die von SCC) ---
SQL_SERVER=localhost
SQL_INSTANZ=
SQL_DATENBANK=IrrgangApps
SQL_BENUTZER=irrgang_mcp
SQL_PASSWORT=
SQL_VERSCHLUESSELN=true
SQL_ZERTIFIKAT_VERTRAUEN=true

# --- Microsoft-Anmeldung für Mitarbeiter (optional) ---
# Leer lassen, solange nur Dienste mit Schlüssel zugreifen
API_AUDIENCE=

# --- Zugangsschlüssel für Dienste (z. B. Nexilo) – nur Hashes! Erzeugen mit:  npm run schluessel -- "Nexilo" schreiben
MCP_SCHLUESSEL=[]
